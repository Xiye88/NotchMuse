<Window x:Class="NotchMuse.App.Overlays.TaskbarLyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        Width="340" Height="48">
    <Border x:Name="RootSurface"
            CornerRadius="8"
            Padding="10,0,10,0"
            Background="Transparent"
            MouseEnter="OnSurfaceEnter"
            MouseLeave="OnSurfaceLeave"
            MouseLeftButtonUp="OnSurfaceClick">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Subtle warm amber note indicator -->
            <Border x:Name="NotePill"
                    Grid.Column="0"
                    Width="22" Height="22"
                    CornerRadius="6"
                    Margin="0,0,9,0"
                    VerticalAlignment="Center"
                    Background="#1FE06D1B">
                <TextBlock x:Name="NoteGlyph"
                           Text="♪"
                           FontSize="12.5"
                           FontWeight="Bold"
                           Foreground="#E06D1B"
                           Margin="0,0,0,1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Single-line or compact bilingual lyrics with real text-clip sweep -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Grid x:Name="SweepHost" HorizontalAlignment="Left" ClipToBounds="True">
                    <TextBlock x:Name="BaseLyricText"
                               Text="NotchMuse"
                               FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="#1A1A1C"
                               TextTrimming="CharacterEllipsis"
                               TextOptions.TextFormattingMode="Display"
                               TextOptions.TextRenderingMode="ClearType"/>
                    <TextBlock x:Name="SweepLyricText"
                               Text="NotchMuse"
                               FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="#E06D1B"
                               TextTrimming="CharacterEllipsis"
                               TextOptions.TextFormattingMode="Display"
                               TextOptions.TextRenderingMode="ClearType">
                        <TextBlock.Clip>
                            <RectangleGeometry x:Name="SweepClip" Rect="0,0,0,40"/>
                        </TextBlock.Clip>
                    </TextBlock>
                </Grid>

                <TextBlock x:Name="SubLyricText"
                           Text=""
                           FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
                           FontSize="10.5"
                           Foreground="#6E6D68"
                           Margin="0,1,0,0"
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed"
                           TextOptions.TextFormattingMode="Display"
                           TextOptions.TextRenderingMode="ClearType"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
