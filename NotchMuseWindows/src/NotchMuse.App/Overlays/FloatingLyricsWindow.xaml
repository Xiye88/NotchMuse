<Window x:Class="NotchMuse.App.Overlays.FloatingLyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        Width="680" Height="132"
        MouseEnter="OnOverlayMouseEnter"
        MouseLeave="OnOverlayMouseLeave">
    <Grid>
        <!-- 1px Vertical Dashed Magnetic Center Snap Guide (shown while dragging in FreeFloat mode) -->
        <Line x:Name="SnapGuide"
              X1="0" Y1="4" X2="0" Y2="128"
              HorizontalAlignment="Center"
              VerticalAlignment="Stretch"
              Stroke="#CCE06D1B"
              StrokeThickness="1"
              StrokeDashArray="4 3"
              Visibility="Collapsed"
              IsHitTestVisible="False"/>

        <!-- Contiguous Hover Zone wrapping Toolbar + Capsule (#01000000 bridge prevents hover drop) -->
        <StackPanel x:Name="OverlayStack"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="Transparent">
            <!-- Compact 5-Action Hover Mini-Toolbar (FreeFloat unlocked only) -->
            <Border x:Name="HoverToolbarHost"
                    HorizontalAlignment="Center"
                    Padding="8,0,8,7"
                    Background="#01000000"
                    Visibility="Collapsed">
                <Border x:Name="HoverToolbar"
                        Padding="6,3"
                        CornerRadius="12"
                        Background="#EB1B1B20"
                        BorderBrush="#36FFFFFF"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#45000000" BlurRadius="12" ShadowDepth="2" Opacity="0.32"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="LockMiniBtn" Content="锁定" Padding="8,3" FontSize="10.5" Foreground="#F3F2EF" Background="Transparent" BorderThickness="0" Click="OnLockClick"/>
                        <Button x:Name="ModeMiniBtn" Content="任务栏" Padding="8,3" FontSize="10.5" Foreground="#F3F2EF" Background="Transparent" BorderThickness="0" Click="OnCycleModeClick"/>
                        <Button x:Name="ThemeMiniBtn" Content="配色" Padding="8,3" FontSize="10.5" Foreground="#F3F2EF" Background="Transparent" BorderThickness="0" Click="OnOpenAppearanceClick"/>
                        <Button x:Name="SettingsMiniBtn" Content="设置" Padding="8,3" FontSize="10.5" Foreground="#F3F2EF" Background="Transparent" BorderThickness="0" Click="OnOpenSettingsClick"/>
                        <Button x:Name="HideMiniBtn" Content="隐藏" Padding="8,3" FontSize="10.5" Foreground="#A5A5AE" Background="Transparent" BorderThickness="0" Click="OnHideClick"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Draggable Frosted Lyrics Capsule (always >= #01000000 when unlocked for 100% Win32 HitTest) -->
            <Border x:Name="LyricCapsule"
                    CornerRadius="18"
                    Padding="24,11"
                    Background="#D13E3E44"
                    BorderBrush="#2EFFFFFF"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="OnCapsuleMouseDown"
                    MouseMove="OnCapsuleMouseMove"
                    MouseLeftButtonUp="OnCapsuleMouseUp"
                    LostMouseCapture="OnCapsuleLostCapture">
                <Border.Effect>
                    <DropShadowEffect x:Name="CapsuleShadow" Color="#50000000" BlurRadius="18" ShadowDepth="4" Opacity="0.30"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <Grid x:Name="SweepHost" HorizontalAlignment="Center">
                        <!-- Adaptive Shadow Backing Layer (activated in Transparent mode for dual-layer crisp outline) -->
                        <TextBlock x:Name="OutlineLyricText"
                                   Text="等待播放音乐…"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Foreground="#CC000000"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="610"
                                   Margin="0,1.2,0,0"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#F0000000" BlurRadius="7" ShadowDepth="0" Opacity="0.95"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <TextBlock x:Name="BaseLyricText"
                                   Text="等待播放音乐…"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Foreground="#99F3F2EF"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="610"/>

                        <TextBlock x:Name="SweepLyricText"
                                   Text="等待播放音乐…"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Foreground="#FF8A36"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="610">
                            <TextBlock.Clip>
                                <RectangleGeometry x:Name="SweepClip" Rect="0,0,0,50"/>
                            </TextBlock.Clip>
                        </TextBlock>
                    </Grid>
                    <TextBlock x:Name="SubLyricText"
                               Text=""
                               FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
                               FontSize="12.5"
                               TextAlignment="Center"
                               Foreground="#C8C6C0"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="600"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
