<Window x:Class="NotchMuse.App.SupportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="支持 NotchMuse"
        Width="780" Height="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="14" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource CanvasBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Strip (Love & Passion Project tone aligned with Mac Build 107) -->
            <Grid Grid.Row="0" Margin="22,0,14,0" MouseLeftButtonDown="OnTitleDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="9" Background="#24E25D6B" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path Data="M 8,13.5 C 8,13.5 2,9.6 2,5.6 C 2,3.7 3.5,2.3 5.2,2.3 C 6.4,2.3 7.4,3.0 8,4.0 C 8.6,3.0 9.6,2.3 10.8,2.3 C 12.5,2.3 14,3.7 14,5.6 C 14,9.6 8,13.5 8,13.5 Z"
                          Fill="#E25D6B" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="HeaderTitle" Text="支持 NotchMuse" FontFamily="{StaticResource StudioDisplayFont}" FontSize="15.5" FontWeight="Bold"/>
                    <TextBlock x:Name="HeaderSubtitle"
                               Text="NotchMuse 是免费开源、为爱发电的独立项目。如果它陪你度过了好时光，欢迎请作者喝杯咖啡，或加入用户群交流反馈。"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource WindowCloseButton}" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnCloseClick">
                    <Path Data="M 2,2 L 10,10 M 10,2 L 2,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource HairlineBrush}"/>

            <!-- Content Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22,18,22,18">
                <StackPanel>
                    <!-- 3-Column Layout: WeChat Pay | QQ User Group | USDT · EVM (Mac Build 107 exact parity!) -->
                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <!-- Card 1 (Left): WeChat Pay -->
                        <Border CornerRadius="14" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="14" Margin="0,0,7,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" CornerRadius="7" Background="#1F10B981" Padding="10,3" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock x:Name="WeChatBadge" Style="{x:Null}" Text="微信支付" FontFamily="{StaticResource StudioFont}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0D9668"/>
                                </Border>
                                <Border Grid.Row="1" Width="162" Height="162" CornerRadius="10" Background="#FFFFFF" Padding="6" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                    <Image x:Name="WeChatQrImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,12,0,0">
                                    <TextBlock x:Name="WeChatHint" Text="打开微信扫一扫赞赏" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="WeChatSubHint" Text="随心打赏，不设门槛" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 2 (Center): QQ User Group -->
                        <Border CornerRadius="14" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="14" Margin="3.5,0,3.5,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" CornerRadius="7" Background="#1F0EA5E9" Padding="10,3" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock x:Name="QqGroupBadge" Style="{x:Null}" Text="QQ 用户交流群" FontFamily="{StaticResource StudioFont}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0284C7"/>
                                </Border>
                                <Border Grid.Row="1" Width="162" Height="162" CornerRadius="10" Background="#FFFFFF" Padding="6" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                    <Image x:Name="QqGroupQrImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>
                                <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,10,0,8">
                                    <TextBlock x:Name="QqGroupHint" Text="交流反馈 · 抢先体验" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="QqGroupIdLabel" Text="群号 1137981671" FontFamily="Consolas, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="CopyQqGroupBtn" Grid.Row="3" Content="复制群号" Padding="14,6" FontSize="11.5" HorizontalAlignment="Center" Click="OnCopyQqGroupClick"/>
                            </Grid>
                        </Border>

                        <!-- Card 3 (Right): USDT · EVM (consolidated network notice inside card!) -->
                        <Border CornerRadius="14" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="14" Margin="7,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" CornerRadius="7" Background="#226366F1" Padding="10,3" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Style="{x:Null}" Text="USDT · EVM" FontFamily="{StaticResource StudioFont}" FontSize="11.5" FontWeight="SemiBold" Foreground="#5B5CE6"/>
                                </Border>
                                <Border Grid.Row="1" Width="162" Height="162" CornerRadius="10" Background="#FFFFFF" Padding="6" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                    <Image x:Name="EvmQrImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>
                                <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,8,0,8">
                                    <TextBlock Text="ETH · BSC · Arbitrum · Optimism" FontSize="9.8" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="EvmOnlyNotice" Text="仅支持 EVM 网络 USDT" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,3"/>
                                    <TextBlock x:Name="EvmAddressLabel" Text="0x6c02…f6d6" FontFamily="Consolas, Segoe UI" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Button x:Name="CopyEvmBtn" Grid.Row="3" Content="复制地址" Padding="14,6" FontSize="11.5" HorizontalAlignment="Center" Click="OnCopyEvmClick"/>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <!-- Live Supporters Wall (synced from Mac's GitHub JSON) -->
                    <Border CornerRadius="12"
                            Background="{DynamicResource DeckBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            Padding="14,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock x:Name="SupportersHeader" Text="鸣谢名单 · Supporters" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Button x:Name="GitHubStarBtn" Content="GitHub Star 支持 ↗" Padding="10,4" FontSize="11" HorizontalAlignment="Right" Click="OnGitHubClick"/>
                            </Grid>
                            <WrapPanel x:Name="SupportersWrap"/>
                            <TextBlock x:Name="SupportersStatusText" Text="正在加载鸣谢名单…" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Non-Blocking Copy Confirmation Toast -->
            <Border x:Name="CopyToast"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,18"
                    CornerRadius="16"
                    Padding="16,8"
                    Background="#EE1C1C22"
                    BorderBrush="#42FFFFFF"
                    BorderThickness="1"
                    Opacity="0"
                    IsHitTestVisible="False">
                <TextBlock x:Name="CopyToastText" Style="{x:Null}" Text="✓  已复制到剪贴板" FontFamily="{StaticResource StudioFont}" FontSize="12" FontWeight="SemiBold" Foreground="#F5F4F0"/>
            </Border>
        </Grid>
    </Border>
</Window>
