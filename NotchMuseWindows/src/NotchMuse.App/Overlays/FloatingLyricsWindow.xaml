<Window x:Class="NotchMuse.App.Overlays.FloatingLyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        Width="680" Height="138"
        MouseEnter="OnOverlayMouseEnter"
        MouseLeave="OnOverlayMouseLeave">
    <Window.Resources>
        <!-- Dedicated high-contrast button template immune to global TextBlock Foreground style! -->
        <Style x:Key="FloatingToolbarButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#F3F2EF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Style="{x:Null}"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2AFFFFFF"/>
                                <Setter Property="Foreground" Value="#FF8A36"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 1px Vertical Dashed Magnetic Center Snap Guide (shown while dragging in FreeFloat mode) -->
        <Line x:Name="SnapGuide"
              X1="0" Y1="4" X2="0" Y2="134"
              HorizontalAlignment="Center"
              VerticalAlignment="Stretch"
              Stroke="#CCE06D1B"
              StrokeThickness="1"
              StrokeDashArray="4 3"
              Visibility="Collapsed"
              IsHitTestVisible="False"/>

        <!-- Contiguous Hover Zone wrapping Toolbar + Capsule (#01000000 bridge prevents hover drop) -->
        <StackPanel x:Name="OverlayStack"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="Transparent">
            <!-- Compact 5-Action Hover Mini-Toolbar (always high-contrast light text on dark frosted pill) -->
            <Border x:Name="HoverToolbarHost"
                    HorizontalAlignment="Center"
                    Padding="8,0,8,7"
                    Background="#01000000"
                    Visibility="Collapsed">
                <Border x:Name="HoverToolbar"
                        Padding="5,3"
                        CornerRadius="11"
                        Background="#F219191F"
                        BorderBrush="#42FFFFFF"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#55000000" BlurRadius="12" ShadowDepth="2" Opacity="0.38"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="LockMiniBtn" Content="锁定" Style="{StaticResource FloatingToolbarButton}" Click="OnLockClick"/>
                        <Border Width="1" Height="12" Background="#28FFFFFF" Margin="1,0" VerticalAlignment="Center"/>
                        <Button x:Name="ModeMiniBtn" Content="任务栏" Style="{StaticResource FloatingToolbarButton}" Click="OnCycleModeClick"/>
                        <Border Width="1" Height="12" Background="#28FFFFFF" Margin="1,0" VerticalAlignment="Center"/>
                        <Button x:Name="ThemeMiniBtn" Content="配色" Style="{StaticResource FloatingToolbarButton}" Click="OnOpenAppearanceClick"/>
                        <Border Width="1" Height="12" Background="#28FFFFFF" Margin="1,0" VerticalAlignment="Center"/>
                        <Button x:Name="SettingsMiniBtn" Content="设置" Style="{StaticResource FloatingToolbarButton}" Click="OnOpenSettingsClick"/>
                        <Border Width="1" Height="12" Background="#28FFFFFF" Margin="1,0" VerticalAlignment="Center"/>
                        <Button x:Name="HideMiniBtn" Content="隐藏" Style="{StaticResource FloatingToolbarButton}" Foreground="#D2D0CA" Click="OnHideClick"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Draggable Frosted Lyrics Capsule (always >= #01000000 when unlocked for 100% Win32 HitTest) -->
            <Border x:Name="LyricCapsule"
                    CornerRadius="18"
                    Padding="24,11"
                    Background="#D13E3E44"
                    BorderBrush="#2EFFFFFF"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="OnCapsuleMouseDown"
                    MouseMove="OnCapsuleMouseMove"
                    MouseLeftButtonUp="OnCapsuleMouseUp"
                    LostMouseCapture="OnCapsuleLostCapture">
                <Border.Effect>
                    <DropShadowEffect x:Name="CapsuleShadow" Color="#50000000" BlurRadius="18" ShadowDepth="4" Opacity="0.30"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <Grid x:Name="SweepHost" HorizontalAlignment="Center">
                        <!-- Adaptive Shadow Backing Layer (activated in Transparent mode for dual-layer crisp outline) -->
                        <TextBlock x:Name="OutlineLyricText"
                                   Style="{x:Null}"
                                   Text="等待播放音乐…"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Foreground="#E0000000"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="610"
                                   Margin="0,1.2,0,0"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#F0000000" BlurRadius="7" ShadowDepth="0" Opacity="0.95"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <TextBlock x:Name="BaseLyricText"
                                   Style="{x:Null}"
                                   Text="等待播放音乐…"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Foreground="#99F3F2EF"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="610"/>

                        <TextBlock x:Name="SweepLyricText"
                                   Style="{x:Null}"
                                   Text="等待播放音乐…"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Foreground="#FF8A36"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="610">
                            <TextBlock.Clip>
                                <RectangleGeometry x:Name="SweepClip" Rect="0,0,0,50"/>
                            </TextBlock.Clip>
                        </TextBlock>
                    </Grid>
                    <TextBlock x:Name="SubLyricText"
                               Style="{x:Null}"
                               Text=""
                               FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
                               FontSize="12.5"
                               TextAlignment="Center"
                               Foreground="#C8C6C0"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="600"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
