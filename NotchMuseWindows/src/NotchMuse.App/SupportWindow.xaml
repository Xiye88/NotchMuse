<Window x:Class="NotchMuse.App.SupportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="支持 NotchMuse"
        Width="780" Height="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="14" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource CanvasBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Strip -->
            <Grid Grid.Row="0" Margin="22,0,14,0" MouseLeftButtonDown="OnTitleDrag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="9" Background="#24E25D6B" Margin="0,0,10,0">
                        <Path Data="M 8,13.5 C 8,13.5 2,9.6 2,5.6 C 2,3.7 3.5,2.3 5.2,2.3 C 6.4,2.3 7.4,3.0 8,4.0 C 8.6,3.0 9.6,2.3 10.8,2.3 C 12.5,2.3 14,3.7 14,5.6 C 14,9.6 8,13.5 8,13.5 Z"
                              Fill="#E25D6B" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitle" Text="请作者喝杯咖啡" FontFamily="{StaticResource StudioDisplayFont}" FontSize="15.5" FontWeight="Bold"/>
                        <TextBlock x:Name="HeaderSubtitle" Text="NotchMuse 永久免费开源 · 你的支持会让 Windows &amp; Mac 双端持续变得更好" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource WindowCloseButton}" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnCloseClick">
                    <Path Data="M 2,2 L 10,10 M 10,2 L 2,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource HairlineBrush}"/>

            <!-- Content Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22,18,22,18">
                <StackPanel>
                    <!-- 3 Payment Channel Cards (Mac SupportWindowController exact parity!) -->
                    <UniformGrid Columns="3" Margin="0,0,0,14">
                        <!-- Card 1: WeChat Pay -->
                        <Border CornerRadius="14" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="14" Margin="0,0,7,0">
                            <StackPanel HorizontalAlignment="Center">
                                <Border CornerRadius="7" Background="#1F10B981" Padding="9,3" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock x:Name="WeChatBadge" Style="{x:Null}" Text="微信赞赏" FontFamily="{StaticResource StudioFont}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0D9668"/>
                                </Border>
                                <Border Width="154" Height="154" CornerRadius="10" Background="#FFFFFF" Padding="6" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                    <Image x:Name="WeChatQrImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock x:Name="WeChatHint" Text="打开微信扫一扫赞赏" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,11,0,2"/>
                                <TextBlock x:Name="WeChatSubHint" Text="随心打赏，不设门槛" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: USDT EVM -->
                        <Border CornerRadius="14" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="14" Margin="3.5,0,3.5,0">
                            <StackPanel HorizontalAlignment="Center">
                                <Border CornerRadius="7" Background="#226366F1" Padding="9,3" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Style="{x:Null}" Text="USDT · EVM" FontFamily="{StaticResource StudioFont}" FontSize="11.5" FontWeight="SemiBold" Foreground="#5B5CE6"/>
                                </Border>
                                <Border Width="154" Height="154" CornerRadius="10" Background="#FFFFFF" Padding="6" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                    <Image x:Name="EvmQrImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>
                                <TextBlock Text="ETH · ARB · Base · BSC · Polygon" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,9,0,4"/>
                                <TextBlock x:Name="EvmAddressLabel" Text="0x6c02...6d6" FontFamily="Consolas, Segoe UI" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,7"/>
                                <Button x:Name="CopyEvmBtn" Content="复制 EVM 地址" Padding="12,5" FontSize="11.5" HorizontalAlignment="Center" Click="OnCopyEvmClick"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: USDT TRON -->
                        <Border CornerRadius="14" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="14" Margin="7,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <Border CornerRadius="7" Background="#22EF4444" Padding="9,3" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Style="{x:Null}" Text="USDT · TRON" FontFamily="{StaticResource StudioFont}" FontSize="11.5" FontWeight="SemiBold" Foreground="#DC2626"/>
                                </Border>
                                <Border Width="154" Height="154" CornerRadius="10" Background="#FFFFFF" Padding="6" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                    <Image x:Name="TronQrImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>
                                <TextBlock Text="TRC-20 Network" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,9,0,4"/>
                                <TextBlock x:Name="TronAddressLabel" Text="TCTrNc...6jan" FontFamily="Consolas, Segoe UI" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,7"/>
                                <Button x:Name="CopyTronBtn" Content="复制 TRC-20 地址" Padding="12,5" FontSize="11.5" HorizontalAlignment="Center" Click="OnCopyTronClick"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Chain Safety Reminder -->
                    <TextBlock x:Name="ChainNoticeText"
                               Text="提示：链上打赏请务必核对对应网络（EVM / TRC-20），仅支持 USDT 转账。感谢每一份温暖支持！"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,14"/>

                    <!-- Live Supporters Wall (synced from Mac's GitHub JSON) -->
                    <Border CornerRadius="12"
                            Background="{DynamicResource DeckBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            Padding="14,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock x:Name="SupportersHeader" Text="鸣谢名单 · Supporters" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Button x:Name="GitHubStarBtn" Content="GitHub Star 支持 ↗" Padding="10,4" FontSize="11" HorizontalAlignment="Right" Click="OnGitHubClick"/>
                            </Grid>
                            <WrapPanel x:Name="SupportersWrap"/>
                            <TextBlock x:Name="SupportersStatusText" Text="正在加载鸣谢名单…" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Non-Blocking Copy Confirmation Toast -->
            <Border x:Name="CopyToast"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,18"
                    CornerRadius="16"
                    Padding="16,8"
                    Background="#EE1C1C22"
                    BorderBrush="#42FFFFFF"
                    BorderThickness="1"
                    Opacity="0"
                    IsHitTestVisible="False">
                <TextBlock x:Name="CopyToastText" Style="{x:Null}" Text="✓  已复制地址到剪贴板" FontFamily="{StaticResource StudioFont}" FontSize="12" FontWeight="SemiBold" Foreground="#F5F4F0"/>
            </Border>
        </Grid>
    </Border>
</Window>
