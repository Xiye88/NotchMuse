<Window x:Class="NotchMuse.App.AnnouncementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotchMuse 最新版本进展"
        Width="540" Height="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="14" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource CanvasBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="62"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="20,0,14,0" MouseLeftButtonDown="OnTitleDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path Data="M 8,1.5 L 9.7,6.3 L 14.5,8 L 9.7,9.7 L 8,14.5 L 6.3,9.7 L 1.5,8 L 6.3,6.3 Z"
                          Fill="{DynamicResource AccentBrush}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="最新版本进展" FontFamily="{DynamicResource StudioDisplayFont}" FontSize="15.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Border x:Name="VersionBadge" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionBadgeText" Style="{x:Null}" Text="v0.9.0" FontFamily="{DynamicResource StudioFont}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="SubtitleText" Text="当前版本 v0.9.0 · 已是最新版本" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{DynamicResource WindowCloseButton}" Width="28" Height="28" VerticalAlignment="Center" Click="OnCloseClick">
                    <Path Data="M 2,2 L 10,10 M 10,2 L 2,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource HairlineBrush}"/>

            <!-- Scrollable Version Notes & Highlights -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16,20,14">
                <StackPanel>
                    <!-- Status Summary Card -->
                    <Border CornerRadius="12"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            Padding="14,12"
                            Margin="0,0,0,14">
                        <TextBlock x:Name="SummaryText"
                                   Text=""
                                   FontSize="12.5"
                                   LineHeight="19"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock x:Name="HighlightsHeading"
                               Text="本版更新亮点"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="2,0,0,8"/>

                    <StackPanel x:Name="HighlightsHost"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" VerticalAlignment="Top" Height="1" Background="{DynamicResource HairlineBrush}"/>

            <!-- Footer Actions -->
            <Grid Grid.Row="2" Margin="20,0,20,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button x:Name="CheckNowButton"
                            Content="立即检查更新"
                            Padding="14,7"
                            FontSize="12"
                            Click="OnCheckNowClick"/>
                    <TextBlock x:Name="CheckStatusText"
                               Text=""
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="DownloadUpdateButton"
                            Content="下载新版"
                            Padding="16,7"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="OnDownloadUpdateClick"/>
                    <Button x:Name="ConfirmButton"
                            Content="我知道了"
                            Padding="18,7"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Click="OnCloseClick"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
