<Window x:Class="NotchMuse.App.Overlays.FloatingLyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        FocusVisualStyle="{x:Null}"
        Width="700" Height="196"
        MouseEnter="OnOverlayMouseEnter"
        MouseLeave="OnOverlayMouseLeave">
    <Window.Resources>
        <!-- Dedicated high-contrast 6-icon toolbar button style (pure vector icons, zero text clutter!) -->
        <Style x:Key="FloatingToolbarIconButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#F3F2EF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2CFFFFFF"/>
                                <Setter Property="Foreground" Value="#FF8A36"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#42FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean 1-row quick color swatch dot (solid or gradient) -->
        <Style x:Key="FloatingColorDot" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring"
                                CornerRadius="11"
                                Padding="2"
                                BorderThickness="1.6"
                                BorderBrush="Transparent">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="9"
                                    BorderBrush="#55FFFFFF"
                                    BorderThickness="0.8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="#D8FFFFFF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="#FF8A36"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid FocusVisualStyle="{x:Null}">
        <!-- 1px Vertical Dashed Magnetic Center Snap Guide (shown while dragging in FreeFloat mode) -->
        <Line x:Name="SnapGuide"
              X1="0" Y1="4" X2="0" Y2="192"
              HorizontalAlignment="Center"
              VerticalAlignment="Stretch"
              Stroke="#CCE06D1B"
              StrokeThickness="1"
              StrokeDashArray="4 3"
              Visibility="Collapsed"
              IsHitTestVisible="False"/>

        <!-- 3-Row Layout: HoverToolbarHost uses Opacity + IsHitTestVisible so LyricCapsule NEVER jumps on hover! -->
        <Grid x:Name="OverlayGrid"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopToolbarRow" Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="BottomToolbarRow" Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Compact 6-Icon Hover Mini-Toolbar hugging LyricCapsule at tight 4px distance! -->
            <Border x:Name="HoverToolbarHost"
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    Padding="6,0,6,4"
                    Background="#01000000"
                    Opacity="0"
                    IsHitTestVisible="False">
                <StackPanel x:Name="HoverToolbarStack" HorizontalAlignment="Center">
                    <!-- Borderless dark-ink micro-label directly above/below the hovered icon -->
                    <Canvas x:Name="MicroTooltipTrack"
                            Height="17"
                            Margin="0,0,0,2"
                            IsHitTestVisible="False"
                            ClipToBounds="False">
                        <TextBlock x:Name="MicroTooltipText"
                                   Style="{x:Null}"
                                   Text=""
                                   FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#1A1A1C"
                                   Opacity="0"
                                   IsHitTestVisible="False">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#F8FFFFFF" BlurRadius="4.5" ShadowDepth="0" Opacity="0.98"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Canvas>

                    <!-- Feather-light 1-Row Quick Color Popover: 7 Solid Dots + Divider + 3 Curated Gradient Dots -->
                    <Border x:Name="QuickColorPopover"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,4"
                            Padding="8,5"
                            CornerRadius="13"
                            Background="#F419191F"
                            BorderBrush="#46FFFFFF"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#55000000" BlurRadius="10" ShadowDepth="2" Opacity="0.34"/>
                        </Border.Effect>
                        <StackPanel x:Name="QuickColorDotsHost" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Main 6-Icon Floating Control Bar (tight 4px hug to LyricCapsule; icons only + hover label!) -->
                    <Border x:Name="HoverToolbar"
                            HorizontalAlignment="Center"
                            Padding="4,2.5"
                            CornerRadius="11"
                            Background="#F219191F"
                            BorderBrush="#42FFFFFF"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#55000000" BlurRadius="10" ShadowDepth="2" Opacity="0.34"/>
                        </Border.Effect>
                        <StackPanel x:Name="ToolbarButtonsPanel" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 1. Lock / Click-Through Auto-Dodge -->
                            <Button x:Name="LockMiniBtn" Style="{StaticResource FloatingToolbarIconButton}"
                                    MouseEnter="OnToolbarButtonEnter" MouseLeave="OnToolbarButtonLeave" Click="OnLockClick">
                                <Path x:Name="LockIconPath"
                                      Data="M 4.5,7 V 5.1 A 3.5,3.5 0 0 1 11.2,4.1 M 3.2,7 H 12.8 A 1.2,1.2 0 0 1 14,8.2 V 13.3 A 1.2,1.2 0 0 1 12.8,14.5 H 3.2 A 1.2,1.2 0 0 1 2,13.3 V 8.2 A 1.2,1.2 0 0 1 3.2,7 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                            <Border Width="1" Height="11" Background="#24FFFFFF" Margin="1,0" VerticalAlignment="Center"/>

                            <!-- 2. Horizontal / Vertical Orientation -->
                            <Button x:Name="OrientationMiniBtn" Style="{StaticResource FloatingToolbarIconButton}"
                                    MouseEnter="OnToolbarButtonEnter" MouseLeave="OnToolbarButtonLeave" Click="OnOrientationClick">
                                <Path x:Name="OrientationIconPath"
                                      Data="M 4.5,2.5 V 13.5 M 9.5,2.5 V 13.5 M 13,5.5 V 10.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                            <Border Width="1" Height="11" Background="#24FFFFFF" Margin="1,0" VerticalAlignment="Center"/>

                            <!-- 3. Quick Color Palette -->
                            <Button x:Name="ColorMiniBtn" Style="{StaticResource FloatingToolbarIconButton}"
                                    MouseEnter="OnToolbarButtonEnter" MouseLeave="OnToolbarButtonLeave" Click="OnToggleQuickColorClick">
                                <Path Data="M 8,2 A 6,6 0 1 0 13.5,10.2 C 13.9,9.3 13.2,8.5 12.2,8.5 H 10.8 A 1.3,1.3 0 0 1 9.5,7.2 C 9.5,6.5 10.1,5.9 10.8,5.9 H 11.4 A 6,6 0 0 0 8,2 Z M 5.2,6.4 A 0.6,0.6 0 1 1 5.2,6.5 Z M 7.7,4.9 A 0.6,0.6 0 1 1 7.7,5.0 Z M 4.9,9.3 A 0.6,0.6 0 1 1 4.9,9.4 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="14.5" Height="14.5" Stretch="Uniform"/>
                            </Button>
                            <Border Width="1" Height="11" Background="#24FFFFFF" Margin="1,0" VerticalAlignment="Center"/>

                            <!-- 4. Open Main Window -->
                            <Button x:Name="OpenMainMiniBtn" Style="{StaticResource FloatingToolbarIconButton}"
                                    MouseEnter="OnToolbarButtonEnter" MouseLeave="OnToolbarButtonLeave" Click="OnOpenMainClick">
                                <Path Data="M 2.5,3.5 H 13.5 A 1.3,1.3 0 0 1 14.8,4.8 V 11.7 A 1.3,1.3 0 0 1 13.5,13 H 2.5 A 1.3,1.3 0 0 1 1.2,11.7 V 4.8 A 1.3,1.3 0 0 1 2.5,3.5 Z M 1.4,6.4 H 14.6"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                            <Border Width="1" Height="11" Background="#24FFFFFF" Margin="1,0" VerticalAlignment="Center"/>

                            <!-- 5. Open Settings -->
                            <Button x:Name="SettingsMiniBtn" Style="{StaticResource FloatingToolbarIconButton}"
                                    MouseEnter="OnToolbarButtonEnter" MouseLeave="OnToolbarButtonLeave" Click="OnOpenSettingsClick">
                                <Path Data="M 8,5.4 A 2.6,2.6 0 1 0 8,10.6 A 2.6,2.6 0 1 0 8,5.4 Z M 8,1.8 V 3.2 M 8,12.8 V 14.2 M 1.8,8 H 3.2 M 12.8,8 H 14.2 M 3.6,3.6 L 4.6,4.6 M 11.4,11.4 L 12.4,12.4 M 12.4,3.6 L 11.4,4.6 M 4.6,11.4 L 3.6,12.4"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                            <Border Width="1" Height="11" Background="#24FFFFFF" Margin="1,0" VerticalAlignment="Center"/>

                            <!-- 6. Hide Floating Lyrics -->
                            <Button x:Name="HideMiniBtn" Style="{StaticResource FloatingToolbarIconButton}" Foreground="#D2D0CA"
                                    MouseEnter="OnToolbarButtonEnter" MouseLeave="OnToolbarButtonLeave" Click="OnHideClick">
                                <Path Data="M 2.3,8 C 3.8,5.1 5.8,3.8 8,3.8 C 10.2,3.8 12.2,5.1 13.7,8 C 12.2,10.9 10.2,12.2 8,12.2 C 5.8,12.2 3.8,10.9 2.3,8 Z M 2.5,2.5 L 13.5,13.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="14.5" Height="14.5" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Draggable Lyrics Capsule: tightly hugs actual lyric width (20px L/R margin, zero oversized bar!) -->
            <Border x:Name="LyricCapsule"
                    Grid.Row="1"
                    CornerRadius="16"
                    Padding="20,10"
                    Background="#D13E3E44"
                    BorderBrush="#2EFFFFFF"
                    BorderThickness="0.75"
                    HorizontalAlignment="Center"
                    Cursor="SizeAll"
                    Focusable="False"
                    FocusVisualStyle="{x:Null}"
                    PreviewMouseLeftButtonDown="OnCapsuleMouseDown">
                <Border.Effect>
                    <DropShadowEffect x:Name="CapsuleShadow" Color="#50000000" BlurRadius="18" ShadowDepth="4" Opacity="0.28"/>
                </Border.Effect>

                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <!-- Horizontal Layout Host (Single or Double-Line) -->
                    <StackPanel x:Name="HorizontalLyricsHost" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid x:Name="SweepHost" HorizontalAlignment="Center">
                            <!-- Adaptive Shadow Backing Layer (activated in Transparent mode for dual-layer crisp outline) -->
                            <TextBlock x:Name="OutlineLyricText"
                                       Style="{x:Null}"
                                       Text="等待播放音乐…"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       Foreground="#E0000000"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="610"
                                       Margin="0,1.2,0,0"
                                       Visibility="Collapsed"
                                       IsHitTestVisible="False">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#F0000000" BlurRadius="7" ShadowDepth="0" Opacity="0.95"/>
                                </TextBlock.Effect>
                            </TextBlock>

                            <TextBlock x:Name="BaseLyricText"
                                       Style="{x:Null}"
                                       Text="等待播放音乐…"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       Foreground="#99F3F2EF"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="610"/>

                            <TextBlock x:Name="SweepLyricText"
                                       Style="{x:Null}"
                                       Text="等待播放音乐…"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       Foreground="#FF8A36"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="610">
                                <TextBlock.Clip>
                                    <RectangleGeometry x:Name="SweepClip" Rect="0,0,0,50"/>
                                </TextBlock.Clip>
                            </TextBlock>
                        </Grid>

                        <!-- Secondary Line: Bilingual Translation OR Upcoming Next Lyric -->
                        <TextBlock x:Name="SubLyricText"
                                   Style="{x:Null}"
                                   Text=""
                                   FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
                                   FontSize="13.5"
                                   TextAlignment="Center"
                                   Foreground="#C8C6C0"
                                   Margin="0,5,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="590"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Vertical Layout Host (Strictly zero horizontal bottom text; tight 12px 2-column gap!) -->
                    <StackPanel x:Name="VerticalLyricsHost"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <!-- Left Column: Upcoming Next Line (visible only in Double-Line Vertical mode, 12px gap to right column!) -->
                        <TextBlock x:Name="VerticalNextText"
                                   Style="{x:Null}"
                                   Text=""
                                   FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                   FontSize="17"
                                   FontWeight="Medium"
                                   TextAlignment="Center"
                                   Foreground="#88F3F2EF"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Top"
                                   Visibility="Collapsed"/>

                        <!-- Right Column: Active Vertical Lyric with Top-to-Bottom Sweep -->
                        <Grid x:Name="VerticalSweepHost" VerticalAlignment="Top">
                            <TextBlock x:Name="VerticalOutlineText"
                                       Style="{x:Null}"
                                       Text=""
                                       FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       Foreground="#E0000000"
                                       Margin="0,1.2,0,0"
                                       Visibility="Collapsed"
                                       IsHitTestVisible="False">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#F0000000" BlurRadius="7" ShadowDepth="0" Opacity="0.95"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock x:Name="VerticalBaseText"
                                       Style="{x:Null}"
                                       Text=""
                                       FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       Foreground="#99F3F2EF"/>
                            <TextBlock x:Name="VerticalSweepText"
                                       Style="{x:Null}"
                                       Text=""
                                       FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       Foreground="#FF8A36">
                                <TextBlock.Clip>
                                    <RectangleGeometry x:Name="VerticalSweepClip" Rect="0,0,48,0"/>
                                </TextBlock.Clip>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
