<UserControl x:Class="NotchMuse.App.Controls.VinylDeckControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="76">
    <Border Background="{DynamicResource DeckBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="10,9">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 44x44 Precision Vinyl Turntable + Metallic Tonearm -->
            <Canvas Grid.Column="0" Width="48" Height="48" VerticalAlignment="Center" HorizontalAlignment="Left">
                <!-- Turntable platter shadow -->
                <Ellipse Canvas.Left="2" Canvas.Top="4" Width="44" Height="44" Fill="#22000000"/>

                <!-- Rotating Vinyl Disc -->
                <Canvas x:Name="VinylDisc" Canvas.Left="2" Canvas.Top="2" Width="44" Height="44" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="DiscRotation" Angle="0"/>
                    </Canvas.RenderTransform>
                    <Ellipse Width="44" Height="44" Fill="#17171B" Stroke="#38FFFFFF" StrokeThickness="0.8"/>
                    <!-- Concentric specular grooves -->
                    <Ellipse Canvas.Left="4" Canvas.Top="4" Width="36" Height="36" Stroke="#1DFFFFFF" StrokeThickness="0.65"/>
                    <Ellipse Canvas.Left="8" Canvas.Top="8" Width="28" Height="28" Stroke="#18FFFFFF" StrokeThickness="0.65"/>
                    <Ellipse Canvas.Left="12" Canvas.Top="12" Width="20" Height="20" Stroke="#16FFFFFF" StrokeThickness="0.65"/>
                    <!-- Subtle vinyl sheen wedge so spin is visibly tactile -->
                    <Path Data="M 22,2 A 20,20 0 0 1 39,12 L 28,18 A 7,7 0 0 0 22,15 Z" Fill="#16FFFFFF"/>
                    <!-- Warm amber center label (shown when no album artwork) -->
                    <Ellipse x:Name="DefaultCenterLabel" Canvas.Left="14" Canvas.Top="14" Width="16" Height="16" Fill="{DynamicResource AccentBrush}"/>
                    <!-- Live Circular Album Cover (~65% of 44px vinyl diameter, spins coaxially!) -->
                    <Ellipse x:Name="AlbumArtDisc" Canvas.Left="7.5" Canvas.Top="7.5" Width="29" Height="29" Stroke="#44FFFFFF" StrokeThickness="0.7" Visibility="Collapsed"/>
                    <!-- Center Spindle Hole (always preserved above cover art) -->
                    <Ellipse Canvas.Left="19" Canvas.Top="19" Width="6" Height="6" Fill="#17171B" Stroke="#48FFFFFF" StrokeThickness="0.6"/>
                </Canvas>

                <!-- Pivoting Metallic Tonearm -->
                <Canvas x:Name="Tonearm" Canvas.Left="34" Canvas.Top="1" Width="16" Height="32" RenderTransformOrigin="0.72,0.14">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="ArmRotation" Angle="-22"/>
                    </Canvas.RenderTransform>
                    <Ellipse Canvas.Left="8.5" Canvas.Top="1.5" Width="6" Height="6" Fill="#9A9AA2" Stroke="#44000000" StrokeThickness="0.6"/>
                    <Path Data="M 11.5,5 L 9.5,20 L 4.5,26" Stroke="#C7C5BE" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    <Border Canvas.Left="1.5" Canvas.Top="24" Width="5.5" Height="3.5" CornerRadius="1" Background="{DynamicResource AccentBrush}"/>
                </Canvas>
            </Canvas>

            <!-- Right Track Status & Live EQ Bars -->
            <Grid Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Row: Status Badge + 3 Mini Warm Amber EQ Bars -->
                <Grid Grid.Row="0" Margin="0,0,0,5">
                    <Border x:Name="StateBadge"
                            HorizontalAlignment="Left"
                            CornerRadius="4"
                            Padding="5,1.5"
                            Background="{DynamicResource ControlBrush}">
                        <TextBlock x:Name="StateText"
                                   Text="IDLE"
                                   FontSize="8.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>

                    <!-- 3-Bar Mini Warm Amber EQ -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="13">
                        <Border x:Name="EqBar1" Width="2.5" Height="5" CornerRadius="1.25" VerticalAlignment="Bottom" Margin="0,0,2,0" Background="{DynamicResource AccentBrush}" Opacity="0.45"/>
                        <Border x:Name="EqBar2" Width="2.5" Height="9" CornerRadius="1.25" VerticalAlignment="Bottom" Margin="0,0,2,0" Background="{DynamicResource AccentBrush}" Opacity="0.45"/>
                        <Border x:Name="EqBar3" Width="2.5" Height="6" CornerRadius="1.25" VerticalAlignment="Bottom" Background="{DynamicResource AccentBrush}" Opacity="0.45"/>
                    </StackPanel>
                </Grid>

                <!-- Track Title -->
                <TextBlock x:Name="TitleText"
                           Grid.Row="1"
                           Text="等待播放音乐…"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Artist · Player -->
                <TextBlock x:Name="SubtitleText"
                           Grid.Row="2"
                           Text="NotchMuse Hi-Fi"
                           FontSize="10.5"
                           Margin="0,2,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
